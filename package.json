{
  "name": "@workos/oagen-emitters",
  "version": "0.24.17",
  "description": "WorkOS' oagen emitters",
  "license": "MIT",
  "author": "WorkOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/workos/oagen-emitters"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint -D warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "format:md": "prettier --write '**/*.md'",
    "lint:all": "oxlint --fix && oxfmt --write . && prettier --write '**/*.md'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "oagen:build:local": "npm --prefix ../oagen run build",
    "dev:link": "npm run oagen:build:local && npm link --prefix ../oagen && npm link @workos/oagen",
    "dev:unlink": "npm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "@workos/oagen": "^0.31.0"
  }
}
